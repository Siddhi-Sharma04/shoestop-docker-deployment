# ─────────────────────────────────────────────────────────────
#  ShoeStop – Environment Variables EXAMPLE
#  Copy this file to .env and fill in your real values.
#  NEVER commit the .env file to version control.
# ─────────────────────────────────────────────────────────────

# ── MongoDB ─────────────────────────────────────────────────
# Your MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# ── JWT Authentication ───────────────────────────────────────
JWT_SECRET=your-very-long-and-random-secret-key-here
JWT_EXPIRY=30d

# ── CORS ────────────────────────────────────────────────────
# In production, set this to your frontend URL
# e.g. https://shoestop.onrender.com
CORS_ORIGIN=*

# ── Frontend API URL ─────────────────────────────────────────
# For LOCAL Docker: http://localhost:5000
# For CLOUD deploy: https://your-backend-service.onrender.com
VITE_API_URL=http://localhost:5000
